      "6dl Gemüsebouillon",
      "Röstzwiebeln",
      "Apfelmus"
    ],
    "Fertigstellen": [
      "Appenzeller Käse gerieben",
      "Röstzwiebeln"
    ]
  },
  "instructions": [
    "Alles in eine Pfanne und aufkochen",
    "Käse daruntermichen, mit Röstzwiebeln und Apfelmus servieren"
  ]
