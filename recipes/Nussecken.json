{
  "name": "Nussecken (Mami Art)",
  "category": "dessert",
  "serving_size": 10,
  "ingredients": {
    "Zutaten": [
      "150g Mehl",
      "1/2 Kafeelöffel Backpulver",
      "70g Zucker",
      "1 Päckchen Vanillezucker",
      "1 Ei",
      "70g Butter",
      "Zutaten verkneten, auf Backpapaier auswallen und mit Johannisbeergelee bestreichen"
    ],
    "Füllung": [
      "200g Butter in Pfanne zerlassen",
      "100g Zucker dazu",
      "1 Päckchen Vanillezucker",
      "4 EL Wasser aufkochen",
      "danach 150g grobgehackte Wahlnüsse und 150 Mandeln darunter mischen und erkalten lassen",
      "nacher auf den Teig streichen"
    ],
    "Glasur": [
      "Mit Schoggiglasur bestreichen"
    ]
  }
}